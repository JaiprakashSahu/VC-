generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
model Lead {
  id        String   @id @default(cuid())
  email     String
  name      String?
  message   String?
  source    String?  // "hero-cta", "pricing-cta", etc.
  createdAt DateTime @default(now())
  @@index([email])
}
